{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivodepot.de/schemas/branding-modul-schema.json",
  "title": "Vivodepot Markenmodul (Branding)",
  "description": "Ein Markenmodul trägt Farben, Schrift, Logo, Name und Kontaktangaben einer Institution; jedes Feld ist einzeln optional, mindestens eines muss gesetzt sein. Maßstab ist der Kern: brandingModulPruefen in vivodepot.html; die Probe tests/mit-modul/modul-schema-branding.test.js hält Schema und Kern im Gleichlauf. Ab moduleVersion 2 darf es ein Erscheinungsbild (erscheinung) und den Schalter poweredByAus tragen (U2-ADR-473 W2). Eingelassen wird ein Markenmodul nur geprüft (signiert).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "moduleVersion"
  ],
  "properties": {
    "modulTyp": {
      "const": "branding"
    },
    "moduleVersion": {
      "description": "Fassung des Moduls, ganzzahlig ab 1.",
      "type": "integer",
      "minimum": 1
    },
    "farbePrimaer": {
      "description": "Hauptfarbe, sechsstelliges Hex (#RRGGBB).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "farbeSekundaer": {
      "description": "Zweitfarbe, sechsstelliges Hex (#RRGGBB).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^#[0-9a-fA-F]{6}$"
    },
    "schriftart": {
      "description": "Name einer Schriftfamilie, ohne Rand-Leerraum 1 bis 100 Zeichen. Der Kern nimmt sie nur an, wenn das Erscheinungsbild des Produkts für sie einen Bildschirm-Schnitt (woff2) trägt oder sie im Grund-Schriftstapel steht; das kann ein Schema nicht sehen.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\s*\\S([\\s\\S]{0,98}\\S)?\\s*$"
    },
    "logo": {
      "description": "Logo als Data-URI, nur PNG oder JPEG (kein SVG), höchstens 200 KB Bilddaten.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^data:image\\/(png|jpeg);base64,[A-Za-z0-9+/]+=*$",
      "maxLength": 273066
    },
    "name": {
      "description": "Name der Institution, reiner Text (kein Markup, keine Zeichenreferenz, kein Anführungszeichen); ohne Rand-Leerraum 1 bis 200 Zeichen.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(?![\\s\\S]*(<[A-Za-z\\/!?]|&(#|[A-Za-z][A-Za-z0-9]*;)|\"))\\s*\\S([\\s\\S]{0,198}\\S)?\\s*$"
    },
    "domain": {
      "description": "Anzeige-Domain (z. B. beispiel.de), kein Link-Ziel; ohne Rand-Leerraum höchstens 100 Zeichen.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\s*(?=\\S{1,100}\\s*$)[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+\\s*$"
    },
    "kontakt": {
      "description": "Kontaktadresse (E-Mail-Form); ohne Rand-Leerraum höchstens 200 Zeichen.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\s*(?=\\S{1,200}\\s*$)[^\\s@<>\"']+@[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+\\s*$"
    },
    "aktualisierungen": {
      "description": "Aktualisierungs-Adresse, nur https; ohne Rand-Leerraum höchstens 300 Zeichen.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\s*(?=\\S{1,300}\\s*$)[hH][tT][tT][pP][sS]:\\/\\/[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+(\\/[^\\s\"'<>]*)?\\s*$"
    },
    "herkunft": {
      "description": "Wer das Modul mitbringt; Kennung beim Ersetzen einer früheren Fassung.",
      "type": "string"
    },
    "appVersion": {
      "description": "Vom Einlass gesetzt.",
      "type": "string"
    },
    "ungeprueft": {
      "description": "Vom Einlass gesetzt.",
      "type": "boolean"
    },
    "eingelassenAm": {
      "description": "Vom Einlass gesetzt.",
      "type": "string"
    },
    "anbieterId": {
      "description": "Vom Einlass gesetzt.",
      "type": "string"
    },
    "anbieterIdGeprueft": {
      "description": "Vom Einlass gesetzt.",
      "type": "boolean"
    },
    "modell": {
      "description": "Wie ein Partnerprodukt die Marke zeigt: 'branding' (Vorgabe) mit der Vivodepot-Bildmarke neben dem Partner-Logo, 'white-label' ohne sie (Vivodepot dann nur am Herkunftsort). Wirkt nur aus der Bau-Region eines konfektionierten Produkts oder aus einem signierten Vor-Depot-Bündel, nie aus einer Depot-Datei; ein anderer Wert wird verworfen.",
      "enum": ["branding", "white-label", null]
    },
    "erscheinung": {
      "description": "Erscheinungsbild (U2-ADR-473 W2), erst ab moduleVersion 2. Es wird über das Erscheinungsbild des Produkts gelegt und mit denselben Regeln geprüft (erscheinungsbildPruefen). Heute nur tokens; schriften folgt mit W4. layout und stil gibt es hier nicht, sie reisen nur gebacken im Erscheinungsbild-Modul. Ein Verstoß lehnt das ganze Modul ab.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "tokens": {
          "description": "Je Ebene (basis, hochkontrast, dunkel wie im Erscheinungsbild-Modul) Token-Name → Wert. Die Namen sind das Vokabular des Gerüsts (ERSCHEINUNGSBILD_REGELN.token) ohne die geschützten und ohne die Bedeutungs-Tokens, die nur das Haus setzt (ERSCHEINUNG_PROFIL_GESPERRT). Kontrast je Ebene, Mindestgrößen und Verweise prüft nur der Kern.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "basis": {
              "$ref": "#/$defs/erscheinungEbene"
            },
            "hochkontrast": {
              "$ref": "#/$defs/erscheinungEbene"
            },
            "dunkel": {
              "$ref": "#/$defs/erscheinungEbene"
            }
          },
          "anyOf": [
            {
              "required": [
                "basis"
              ],
              "properties": {
                "basis": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            },
            {
              "required": [
                "hochkontrast"
              ],
              "properties": {
                "hochkontrast": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            },
            {
              "required": [
                "dunkel"
              ],
              "properties": {
                "dunkel": {
                  "type": "object",
                  "minProperties": 1
                }
              }
            }
          ]
        }
      }
    },
    "poweredByAus": {
      "description": "Schalter „powered by aus“ (U2-ADR-473 W2): true blendet den Hinweis in der App-Fußzeile aus, erst ab moduleVersion 2 und nur, wenn das Modul durch die Signaturprüfung kam. Die Ausgaben tragen „Erstellt mit der Software Vivodepot“ immer. false heißt nicht gesetzt.",
      "type": "boolean"
    }
  },
  "anyOf": [
    {
      "required": [
        "farbePrimaer"
      ],
      "properties": {
        "farbePrimaer": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "farbeSekundaer"
      ],
      "properties": {
        "farbeSekundaer": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "schriftart"
      ],
      "properties": {
        "schriftart": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "logo"
      ],
      "properties": {
        "logo": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "domain"
      ],
      "properties": {
        "domain": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "kontakt"
      ],
      "properties": {
        "kontakt": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "aktualisierungen"
      ],
      "properties": {
        "aktualisierungen": {
          "type": "string"
        }
      }
    },
    {
      "required": [
        "erscheinung"
      ],
      "properties": {
        "erscheinung": {
          "type": "object"
        }
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "required": [
          "erscheinung"
        ],
        "properties": {
          "erscheinung": {
            "type": "object"
          }
        }
      },
      "then": {
        "properties": {
          "moduleVersion": {
            "type": "integer",
            "minimum": 2
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "poweredByAus"
        ],
        "properties": {
          "poweredByAus": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "moduleVersion": {
            "type": "integer",
            "minimum": 2
          }
        }
      }
    }
  ],
