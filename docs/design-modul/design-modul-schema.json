        },
        "--flaeche-hover": {
          "$ref": "#/$defs/farbe"
        },
        "--flaeche-neutral": {
          "$ref": "#/$defs/farbe"
        },
        "--ink": {
          "$ref": "#/$defs/farbe"
        },
        "--ink2": {
          "$ref": "#/$defs/farbe"
        },
        "--ink3": {
          "$ref": "#/$defs/farbe"
        },
        "--line": {
          "$ref": "#/$defs/farbe"
        },
        "--whitelabel-primary": {
          "$ref": "#/$defs/farbe"
        },
        "--white": {
          "$ref": "#/$defs/farbe"
        },
        "--auf-akzent": {
          "$ref": "#/$defs/farbe"
        },
        "--success": {
          "$ref": "#/$defs/farbe"
        },
        "--warning": {
          "$ref": "#/$defs/farbe"
        },
        "--error": {
          "$ref": "#/$defs/farbe"
        },
        "--info": {
          "$ref": "#/$defs/farbe"
        },
        "--teal": {
          "$ref": "#/$defs/farbe"
        },
        "--modus-anker": {
          "$ref": "#/$defs/farbe"
        },
        "--modus-vollmacht": {
          "$ref": "#/$defs/farbe"
        },
        "--modus-angehoerigen": {
          "$ref": "#/$defs/farbe"
        },
        "--modus-notfall": {
          "$ref": "#/$defs/farbe"
        },
        "--hafer": {
          "$ref": "#/$defs/farbe"
        },
        "--schilf": {
          "$ref": "#/$defs/farbe"
        },
        "--hafer-text": {
          "$ref": "#/$defs/farbe"
        },
        "--schilf-text": {
          "$ref": "#/$defs/farbe"
        },
        "--hafer-linie": {
          "$ref": "#/$defs/farbe"
        },
        "--schilf-linie": {
          "$ref": "#/$defs/farbe"
        },
        "--hafer-papier-linie": {
          "$ref": "#/$defs/farbe"
        },
        "--schilf-papier-linie": {
          "$ref": "#/$defs/farbe"
        },
        "--font-narrativ": {
          "$ref": "#/$defs/schrift"
        },
        "--font-inter": {
          "$ref": "#/$defs/schrift"
        },
        "--line-feiner": {
          "$ref": "#/$defs/farbe"
        },
        "--fs-xs": {
          "$ref": "#/$defs/laenge"
        },
        "--fs-xl": {
