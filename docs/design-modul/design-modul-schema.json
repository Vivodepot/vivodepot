  "$defs": {
    "farbe": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Sechsstelliges Hex (#RRGGBB)."
    },
    "schrift": {
      "type": "string",
      "pattern": "^\\s*\\S([\\s\\S]{0,98}\\S)?\\s*$",
      "description": "Schriftstapel; ohne Rand-Leerraum 1 bis 100 Zeichen."
    },
    "laenge": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?(px|rem|em)$",
      "description": "Zahl mit px, rem oder em."
    },
    "schatten": {
      "type": "string",
      "pattern": "^((?:0|-?[0-9]+(?:\\.[0-9]+)?px)\\s+){2,4}rgba?\\([0-9]{1,3}\\s*,\\s*[0-9]{1,3}\\s*,\\s*[0-9]{1,3}(\\s*,\\s*(0|1|0?\\.[0-9]+))?\\)$",
      "description": "Zwei bis vier Längen (die vierte ist die Ausbreitung), dann rgb()/rgba(); ein einzelner Schatten."
    },
    "zahl": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
      "description": "Zahl ohne Einheit, z. B. ein Schriftgewicht (400, 600)."
    },
    "schleier": {
      "type": "string",
      "pattern": "^rgba\\(\\s*[0-9]{1,3}\\s*,\\s*[0-9]{1,3}\\s*,\\s*[0-9]{1,3}\\s*,\\s*(0|1|0?\\.[0-9]+)\\s*\\)$",
      "description": "Farbe mit Deckkraft, rgba(r, g, b, a)."
    },
    "rahmen": {
      "type": "string",
      "pattern": "^(none|(0|[0-9]+(\\.[0-9]+)?px)\\s+(solid|dashed|dotted)\\s+#[0-9a-fA-F]{6})$",
      "description": "none oder Breite in px, Stil (solid, dashed, dotted) und sechsstelliges Hex."
    }
  }
}
