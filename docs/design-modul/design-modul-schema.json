  },
  "$defs": {
    "farbe": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$",
      "description": "Sechsstelliges Hex (#RRGGBB)."
    },
    "schrift": {
      "type": "string",
      "pattern": "^\\s*\\S([\\s\\S]{0,98}\\S)?\\s*$",
      "description": "Schriftstapel; ohne Rand-Leerraum 1 bis 100 Zeichen."
    },
    "laenge": {
      "type": "string",
      "pattern": "^-?[0-9]+(\\.[0-9]+)?(px|rem|em)$",
      "description": "Zahl mit px, rem oder em."
    },
    "schatten": {
      "type": "string",
      "pattern": "^((?:0|-?[0-9]+(?:\\.[0-9]+)?px)\\s+){2,3}rgba?\\([0-9]{1,3}\\s*,\\s*[0-9]{1,3}\\s*,\\s*[0-9]{1,3}(\\s*,\\s*(0|1|0?\\.[0-9]+))?\\)$",
      "description": "Zwei oder drei Längen, dann rgb()/rgba()."
    }
  }
}
