{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivodepot.de/schemas/design-modul-schema.json",
  "title": "Vivodepot Designmodul",
  "description": "Ein Designmodul setzt freigegebene Design-Tokens der Oberfläche (Name → Wert). Maßstab ist der Kern: designModulPruefen in vivodepot.html; die Probe tests/mit-modul/modul-schema-design.test.js hält Schema und Kern im Gleichlauf. Nur die hier aufgeführten Tokens sind setzbar; vom Kern berechnete und vom Markenmodul belegte Tokens sind es nicht. Mindestens ein Token muss gesetzt sein.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tokens"
  ],
  "properties": {
    "tokens": {
      "description": "Token-Name → Wert in der Form seiner Kategorie.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "--salbei-dunkel": {
          "$ref": "#/$defs/farbe"
        },
        "--salbei-mid": {
          "$ref": "#/$defs/farbe"
        },
        "--salbei-light": {
