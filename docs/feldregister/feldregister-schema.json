{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivodepot.de/schemas/feldregister-schema.json",
  "title": "Vivodepot Feldregister",
  "description": "Die Datei feldregister.json unter https://register.vivodepot.de/ und im Paket @vivodepot/feldregister. Erzeugt von tools/feldregister-bauen.js.",
  "type": "object",
  "required": ["hinweis", "fassung", "lizenz", "herausgeber", "schluesselraum", "adressen", "anzahl", "herkunft", "felder"],
  "additionalProperties": false,
  "properties": {
    "hinweis": { "type": "string" },
    "fassung": {
      "type": "object",
      "required": ["datum", "kern"],
      "additionalProperties": false,
      "properties": {
        "datum": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "kern": { "type": "string", "pattern": "^v[0-9]+$" }
      }
    },
    "lizenz": {
      "type": "object",
      "required": ["spdx", "url", "gilt_fuer", "nicht_fuer"],
      "additionalProperties": false,
      "properties": {
        "spdx": { "const": "CC0-1.0" },
        "url": { "const": "https://creativecommons.org/publicdomain/zero/1.0/" },
        "gilt_fuer": { "type": "string" },
        "nicht_fuer": { "type": "string" }
      }
    },
    "herausgeber": { "type": "string" },
    "schluesselraum": { "const": "kennung" },
    "adressen": {
      "type": "object",
      "required": ["kennung", "begriffsschema", "jsonld", "fassungen"],
      "additionalProperties": false,
      "properties": {
        "kennung": { "const": "https://register.vivodepot.de/feld/<kennung>" },
        "begriffsschema": { "const": "https://register.vivodepot.de/feld/" },
        "jsonld": { "type": "string" },
        "fassungen": { "type": "string" }
      }
    },
    "anzahl": { "type": "integer", "minimum": 1 },
    "herkunft": {
      "type": "object",
      "required": ["quelle", "erzeugerDerQuelle", "kennungsform", "pruefsumme", "quellenhinweis"],
      "additionalProperties": false,
      "properties": {
        "quelle": { "type": "string" },
        "erzeugerDerQuelle": { "type": "string" },
        "kennungsform": { "type": "string" },
        "pruefsumme": { "type": "string" },
        "quellenhinweis": { "type": "string" }
      }
    },
    "felder": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kennung", "bereich", "status", "label", "uri"],
        "additionalProperties": false,
        "properties": {
          "kennung": { "type": "string", "pattern": "^[A-Za-z0-9._-]{2,}(/[A-Za-z0-9._-]{2,})?$" },
          "bereich": { "type": "string", "minLength": 1 },
          "status": { "enum": ["permanent", "deprecated", "obsoleted"] },
          "nachfolger": { "type": "string" },
          "label": {
            "type": "object",
            "required": ["de", "en"],
            "additionalProperties": false,
            "properties": {
              "de": { "type": "string", "minLength": 1 },
              "en": { "type": "string", "minLength": 1 }
            }
          },
          "uri": { "type": "string", "pattern": "^https://register\\.vivodepot\\.de/feld/" }
        }
      }
    }
  }
}
