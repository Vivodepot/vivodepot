{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivodepot.de/schemas/format-modul-schema.json",
  "title": "Vivodepot Format-Modul (Ein- oder Ausgabekanal)",
  "description": "Ein Format-Modul beschreibt einen Ein- oder Ausgabekanal: welche Datei er erkennt und welcher Pfad in ihr auf welches Depot-Feld führt. Es liefert nur Werte, nie Code — Leser und Schreiber werden namentlich aus dem Kern gewählt. Maßstab ist der Kern: formatModulPruefen in vivodepot.html; die Probe tests/mit-modul/modul-schema-format.test.js hält Schema und Kern im Gleichlauf. Ein Modul, das dieses Schema erfüllt, ist der Form nach sauber. Was am laufenden Bestand hängt, prüft nur der Kern: ob die Kennung `format` ab Werk belegt ist (`reserviert`), ob `sektor` ein bekannter Bereich ist, ob `leser`/`schreiber` auflösen und ob jedes `zuordnung[].feld` im Bereich existiert (unbekannte Felder verwirft er einzeln; bleibt keine Zuordnung übrig, lehnt er ab).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "moduleVersion",
    "sektor",
    "label",
    "sprache",
    "zuordnung"
  ],
  "$defs": {
    "pfad": {
      "description": "Punkt-getrennter Pfad; kein leeres Teilstück, keins davon `__proto__`, `constructor` oder `prototype`.",
      "type": "string",
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[^.]+(?:\\.[^.]+)*$"
        },
        {
          "not": {
            "pattern": "(?:^|\\.)(?:__proto__|constructor|prototype)(?:\\.|$)"
          }
        }
      ]
    },
    "pfadStufen": {
      "description": "U2-ADR-465 Nachtrag: ein Pfad als Liste von Stufen, für Schlüssel mit Punkt (etwa „G99000002V1.0“). Jede Stufe ist ein Text, nicht nur Leerraum, keiner davon `__proto__`, `constructor` oder `prototype`; höchstens 64 Stufen.",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "\\S",
        "not": {
          "enum": [
            "__proto__",
            "constructor",
            "prototype"
          ]
        }
      }
    },
    "ziel": {
      "description": "Ein Ziel: Punkt-getrennter Pfad oder (U2-ADR-465 Nachtrag) Liste von Pfadstufen. Eine Stufe mit Punkt gibt es nur in der Listenform.",
      "anyOf": [
        {
          "$ref": "#/$defs/pfad"
        },
        {
          "$ref": "#/$defs/pfadStufen"
        }
      ]
    },
    "xmlPfad": {
      "description": "Pfad aus XML-Namen (ohne Präfix); nur die letzte Stufe darf `#text` oder `@name` sein.",
      "type": "string",
      "pattern": "^(?:[\\p{L}_][\\p{L}\\p{N}_·-]*\\.)*(?:[\\p{L}_][\\p{L}\\p{N}_·-]*|#text|@[\\p{L}_][\\p{L}\\p{N}_·-]*)$"
    },
    "xmlPfadStufen": {
      "description": "U2-ADR-465 Nachtrag: Liste von Pfadstufen aus XML-Namen (Punkte erlaubt); `#text` und `@name` nur als letzte Stufe (prüft der Kern).",
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "string",
        "pattern": "^(?:[\\p{L}_][\\p{L}\\p{N}._·-]*|#text|@[\\p{L}_][\\p{L}\\p{N}._·-]*)$"
      }
    },
    "ableitung": {
      "description": "U2-ADR-465 Nachtrag (04.11.2026): eine Regel aus der Kern-Liste FORMAT_ABLEITUNGEN und ein Feld; Ergebnis ja/nein. Ob das Feld existiert, prüft nur der Kern. Nachtrag 05.11.2026: `heute` (das Datum des Geräts) ohne Feld, wahlweise mit `teil`; an den ja/nein-Regeln wahlweise `werte` (Codes).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "regel"
      ],
      "properties": {
        "regel": {
          "enum": [
            "nichtLeer",
            "gleich",
            "ausListe",
            "heute"
          ]
        },
        "feld": {
          "type": "string",
          "pattern": "\\S"
        },
        "bereich": {
          "type": "string",
          "pattern": "\\S"
        },
        "wert": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "liste": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "teil": {
          "enum": [
            "jahr",
            "monat",
            "tag",
            "zeitpunkt"
          ]
        },
        "werte": {
          "$ref": "#/$defs/janeinWerte"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "regel": {
                "const": "gleich"
              }
            }
          },
          "then": {
            "required": [
              "wert"
            ],
            "properties": {
              "wert": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              },
              "liste": false
            }
          },
          "else": {
            "properties": {
              "wert": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "regel": {
                "const": "ausListe"
              }
            }
          },
          "then": {
            "required": [
              "liste"
            ],
            "properties": {
              "liste": {
                "type": "array"
              }
            }
          },
          "else": {
            "properties": {
              "liste": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "regel": {
                "const": "heute"
              }
            }
          },
          "then": {
            "properties": {
              "feld": false,
              "bereich": false,
              "wert": false,
              "liste": false,
              "werte": false
            }
          },
          "else": {
            "required": [
              "feld"
            ],
            "properties": {
              "teil": false
            }
          }
        }
      ]
    },
    "zahlenpaar": {
      "description": "U2-ADR-465 Nachtrag (W6): Unter- und Obergrenze, je eine Zahl oder null (offen).",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": [
          "number",
          "null"
        ]
      }
    },
    "pruefungEintrag": {
      "description": "U2-ADR-465 Nachtrag (W6, 04.11.2026): eine Regel der Vorprüfung je Element des XSD, in Dokumentfolge. Eine Gruppe (`gruppe: true`) trägt nur Anzahl und Name; ein Element trägt dazu Datentyp und Facetten. `anhang` steht für xs:anyType.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ziel",
        "min",
        "max"
      ],
      "properties": {
        "ziel": {
          "$ref": "#/$defs/pfad"
        },
        "name": {
          "type": "string",
          "maxLength": 300
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "description": "Höchstzahl; null heißt unbegrenzt.",
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "gruppe": {
          "const": true
        },
        "typ": {
          "enum": [
            "string",
            "normalizedString",
            "token",
            "integer",
            "decimal",
            "float",
            "double",
            "boolean",
            "date",
            "dateTime",
            "anhang"
          ]
        },
        "laenge": {
          "$ref": "#/$defs/zahlenpaar"
        },
        "bereich": {
          "$ref": "#/$defs/zahlenpaar"
        },
        "werte": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2000,
          "items": {
            "type": "string"
          }
        },
        "muster": {
          "description": "Muster des XSD; der Kern prüft nur eine enge Form, sonst „nicht vorgeprüft“ (formatMusterUebersetzen).",
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      },
      "oneOf": [
        {
          "required": [
            "gruppe"
          ],
          "properties": {
            "gruppe": true,
            "typ": false,
            "laenge": false,
            "bereich": false,
            "werte": false,
            "muster": false
          }
        },
        {
          "required": [
            "typ"
          ],
          "properties": {
            "typ": true,
            "gruppe": false
          }
        }
      ]
    },
    "janeinWerte": {
      "description": "U2-ADR-465 Nachtrag (05.11.2026): der Code für ja und für nein in der Datei, statt true/false.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ja",
        "nein"
      ],
      "properties": {
        "ja": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        },
        "nein": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ]
        }
      }
    }
  },
  "properties": {
    "modulTyp": {
      "const": "format"
    },
    "moduleVersion": {
      "description": "Fassung des Moduls, ganzzahlig ab 1.",
      "type": "integer",
      "minimum": 1
    },
    "format": {
      "description": "Kennung des Kanals. Ab Werk belegte Kennungen sind nicht überschreibbar (prüft nur der Kern).",
      "type": "string",
      "pattern": "\\S"
    },
    "richtung": {
      "description": "`import` (Vorgabe, auch bei null) oder `export`.",
      "enum": [
        "import",
        "export",
        null
      ]
    },
    "sektor": {
      "description": "Bereich, in den der Kanal liest oder aus dem er schreibt; muss dem Kern bekannt sein.",
      "type": "string",
      "pattern": "\\S"
    },
    "label": {
      "description": "Beschriftung im Import-Dialog. Reiner Text: kein Tag, keine Zeichenreferenz, kein doppeltes Anführungszeichen.",
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "<[A-Za-z/!?]|&(?:#|[A-Za-z][A-Za-z0-9]*;)|\""
      }
    },
    "sprache": {
      "description": "Sprache von `label` (BCP-47-Form, z. B. `de`, `en-GB`). Pflicht, weil jedes Format-Modul eine Beschriftung trägt.",
      "type": "string",
      "pattern": "^\\s*[a-z]{2,3}(-[A-Za-z0-9]{2,8})*\\s*$"
    },
    "akzeptiert": {
      "description": "Dateiauswahl-Filter; fehlt er, gilt `.json,application/json`.",
      "type": [
        "string",
        "null"
      ]
    },
    "leser": {
      "description": "Kennung einer eingebauten Lesart (`name@version`). Pflicht bei `richtung: import`; muss auflösen (prüft nur der Kern).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    },
    "schreiber": {
      "description": "Kennung eines eingebauten Schreibers (`name@version`); fehlt er, gilt `json@1`. Muss auflösen (prüft nur der Kern).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    },
    "quelle": {
      "description": "Umschlag: der Pfad, unter dem die Werte in der Datei stehen.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/pfad"
        }
      ]
    },
    "quelleWurzelFallback": {
      "description": "Wird der Umschlag nicht gefunden, auf der Wurzel lesen.",
      "type": "boolean"
    },
    "rechtsraum": {
      "description": "Freiwillig: der Rechtsraum, an den der Kanal gebunden ist.",
      "type": [
        "string",
        "null"
      ]
    },
    "namensraum": {
      "description": "U2-ADR-465: Namensraum des Ziel-XML, als Standard-Namensraum an die Wurzel geschrieben. Nur für Ausgabe-Module mit dem Schreiber xml@1. Einen fremden Namensraum (alles außer urn:vivodepot: und https://vivodepot.de/) gibt der Kern nur einem Modul mit verifizierter Signatur frei (prüft nur der Kern).",
      "type": "string",
      "pattern": "^(?:urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:\\S+|https?://\\S+)$"
    },
    "wurzel": {
      "description": "U2-ADR-465: Name des Wurzelelements, unmittelbar statt als Pfad (ein XML-Name darf Punkte tragen, ein Pfad nicht). Nur an einem Ausgabe-Modul mit xml@1, und nicht zusammen mit `quelle`.",
      "type": "string",
      "pattern": "^[\\p{L}_][\\p{L}\\p{N}._·-]*$"
    },
    "hinweis": {
      "description": "U2-ADR-465: ein Hinweis des Moduls, den der Kern als XML-Kommentar vor die Wurzel schreibt (etwa „nicht einreichbar ohne Anhang“). Nur an einem Ausgabe-Modul mit xml@1; kein „--“, nicht auf „-“ endend.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!.*--)[^\\u0000-\\u001f<>]*[^\\u0000-\\u001f<>-]$"
    },
    "schemaUri": {
      "description": "U2-ADR-465 Nachtrag: die Kennung des Schemas, das die Ausgabe erfüllen soll (etwa die Adresse eines FIM-JSON-Schemas) — nur Text, der Kern löst sie nie auf. Nur an einem Ausgabe-Modul. Eine Adresse außerhalb von https://vivodepot.de/ gibt der Kern nur einem Modul mit verifizierter Signatur frei (prüft nur der Kern).",
      "type": "string",
      "pattern": "^https://[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+/[A-Za-z0-9._~/-]{1,400}$"
    },
    "pruefung": {
      "description": "U2-ADR-465 Nachtrag (W6, 04.11.2026): die Regeln aus dem XSD der Leistung, mit denen der Kern die Ausgabe vor dem Speichern vorprüft (Pflicht, Anzahl, Reihenfolge, Datentyp, Länge, Bereich, Aufzählung, Muster). Erzeugt von tools/fim-modul-erzeugen.mjs. Nur an einem XML-Ausgabekanal mit `wurzel`.",
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "$ref": "#/$defs/pruefungEintrag"
      }
    },
    "erkennen": {
      "description": "UND-verknüpfte Vergleiche, an denen der Kanal seine Datei erkennt. Fehlt die Liste, wird der Kanal von Hand gewählt.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pfad"
        ],
        "properties": {
          "pfad": {
            "$ref": "#/$defs/pfad"
          },
          "gleich": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "vorhanden": {
            "type": "boolean"
          },
          "istObjekt": {
            "type": "boolean"
          }
        },
        "anyOf": [
          {
            "required": [
              "gleich"
            ],
            "properties": {
              "gleich": true
            }
          },
          {
            "required": [
              "vorhanden"
            ],
            "properties": {
              "vorhanden": {
                "const": true
              }
            }
          },
          {
            "required": [
              "istObjekt"
            ],
            "properties": {
              "istObjekt": {
                "const": true
              }
            }
          }
        ]
      }
    },
    "zuordnung": {
      "description": "Depot-Feld ↔ Pfad in der Datei. Ein Modul erfindet kein Feld: `feld` muss im Bereich `sektor` (bzw. `bereich`) existieren (prüft nur der Kern). U2-ADR-465: `bereich` liest ein Feld aus einem anderen Bereich, `fest` schreibt einen festen Wert statt eines Felds; beides trägt nur in der Ausgabe (der Kern verwirft es beim Einlesen einzeln). Die Folge der Einträge ist die Elementfolge. `werte` bildet den Rohwert auf einen Zielwert ab, `teil` nimmt einen Teil eines Datums; beides nur in der Ausgabe. U2-ADR-465 Nachtrag: `anhang` nennt die Rolle eines Anhangs (die Datei wählt die Person beim Export), `pflicht` sagt, ob ohne ihn keine Datei entsteht; `vertreter` ist ein Feld der bevollmächtigten Person und steht nur mit der Rolle `vollmacht-nachweis` (prüft der Kern). Beide allein, ohne `feld` und `fest`. U2-ADR-465 Nachtrag (04.11.2026): `abgeleitet` rechnet ja/nein aus einem Feld nach einer Regel des Kerns, `antrag` ist eine Frage an die Person beim Erzeugen (die Antwort wird nicht gespeichert); beide allein, nur mit `ziel`, nur in der Ausgabe.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ziel"
        ],
        "properties": {
          "feld": {
            "type": "string",
            "pattern": "\\S"
          },
          "ziel": {
            "$ref": "#/$defs/ziel"
          },
          "alsListe": {
            "type": "boolean"
          },
          "bereich": {
            "type": "string",
            "pattern": "\\S"
          },
          "fest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "werte": {
            "description": "U2-ADR-465: Rohwert des Felds → Zielwert (etwa ein Code der Codeliste des Ziels). Ein Rohwert ohne Eintrag ergibt keinen Wert und wird gemeldet.",
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1000,
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "teil": {
            "description": "U2-ADR-465: ein Teil eines Datums (aus der Kern-Liste FORMAT_TEILE).",
            "enum": [
              "jahr",
              "monat",
              "tag",
              "zeitpunkt"
            ]
          },
          "anhang": {
            "description": "U2-ADR-465 Nachtrag: Rolle eines Anhangs aus der Kern-Liste FORMAT_ANHANG_ROLLEN.",
            "enum": [
              "bescheid",
              "vollmacht-nachweis",
              "lichtbild",
              "betreuungsurkunde",
              "aufenthaltstitel-nachweis",
              "mietnachweis",
              "nachweis-kinderbetreuung",
              "nachweis"
            ]
          },
          "pflicht": {
            "description": "U2-ADR-465 Nachtrag: nur am Anhang.",
            "type": "boolean"
          },
          "vertreter": {
            "description": "U2-ADR-465 Nachtrag: Feld der bevollmächtigten Person (Kern-Liste FORMAT_VERTRETER_FELDER).",
            "enum": [
              "familyName",
              "givenName",
              "street",
              "houseNumber",
              "postalCode",
              "city"
            ]
          },
          "codeliste": {
            "description": "U2-ADR-482: das Feld ist ein Rechtsraum-Codefeld (heute identity.nationality); das Ziel trägt die Codes der PID-Form (ISO 3166-1 alpha-2, QS, QU). Die Abbildung kommt aus dem Kern, dieselbe wie die des eingebauten PID-Kanals, alle oder keine. Nur an einem Codefeld (prüft der Kern); ein einlesendes Modul, das ein Codefeld ohne codeliste zuordnet, verliert diese Zuordnung.",
            "const": true
          },
          "abgeleitet": {
            "$ref": "#/$defs/ableitung"
          },
          "antrag": {
            "description": "U2-ADR-465 Nachtrag (04.11.2026): eine Frage beim Erzeugen; Typ aus der Kern-Liste FORMAT_ANTRAG_TYPEN, `werte` genau bei `auswahl`, `vorschlag` nur bei `janein`. Dass jede `id` nur einmal vorkommt, prüft nur der Kern. Nachtrag 05.11.2026: an `janein` wahlweise `werte: { ja, nein }` (Codes); ein `vorschlag` ohne `heute` und ohne `werte`.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "frage",
              "typ"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_.-]{1,64}$"
              },
              "frage": {
                "type": "string",
                "pattern": "\\S",
                "maxLength": 300
              },
              "typ": {
                "enum": [
                  "janein",
                  "text",
                  "datum",
                  "auswahl"
                ]
              },
              "werte": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1000
              },
              "pflicht": {
                "type": "boolean"
              },
              "vorschlag": {
                "allOf": [
                  {
                    "$ref": "#/$defs/ableitung"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "regel": {
                        "not": {
                          "const": "heute"
                        }
                      },
                      "werte": false
                    }
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "typ": {
                      "const": "auswahl"
                    }
                  }
                },
                "then": {
                  "required": [
                    "werte"
                  ],
                  "properties": {
                    "werte": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string",
                        "pattern": "\\S",
                        "maxLength": 300
                      }
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "typ": {
                      "const": "janein"
                    }
                  }
                },
                "then": {
                  "properties": {
                    "werte": {
                      "$ref": "#/$defs/janeinWerte"
                    }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "typ": {
                      "enum": [
                        "text",
                        "datum"
                      ]
