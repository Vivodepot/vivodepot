{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivodepot.de/schemas/format-modul-schema.json",
  "title": "Vivodepot Format-Modul (Ein- oder Ausgabekanal)",
  "description": "Ein Format-Modul beschreibt einen Ein- oder Ausgabekanal: welche Datei er erkennt und welcher Pfad in ihr auf welches Depot-Feld führt. Es liefert nur Werte, nie Code — Leser und Schreiber werden namentlich aus dem Kern gewählt. Maßstab ist der Kern: formatModulPruefen in vivodepot.html; die Probe tests/mit-modul/modul-schema-format.test.js hält Schema und Kern im Gleichlauf. Ein Modul, das dieses Schema erfüllt, ist der Form nach sauber. Was am laufenden Bestand hängt, prüft nur der Kern: ob die Kennung `format` ab Werk belegt ist (`reserviert`), ob `sektor` ein bekannter Bereich ist, ob `leser`/`schreiber` auflösen und ob jedes `zuordnung[].feld` im Bereich existiert (unbekannte Felder verwirft er einzeln; bleibt keine Zuordnung übrig, lehnt er ab).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "moduleVersion",
    "sektor",
    "label",
    "sprache",
    "zuordnung"
  ],
  "$defs": {
    "pfad": {
      "description": "Punkt-getrennter Pfad; kein leeres Teilstück, keins davon `__proto__`, `constructor` oder `prototype`.",
      "type": "string",
      "allOf": [
        {
          "pattern": "\\S"
        },
        {
          "pattern": "^[^.]+(?:\\.[^.]+)*$"
        },
        {
          "not": {
            "pattern": "(?:^|\\.)(?:__proto__|constructor|prototype)(?:\\.|$)"
          }
        }
      ]
    },
    "xmlPfad": {
      "description": "Pfad aus XML-Namen (ohne Präfix); nur die letzte Stufe darf `#text` oder `@name` sein.",
      "type": "string",
      "pattern": "^(?:[\\p{L}_][\\p{L}\\p{N}_·-]*\\.)*(?:[\\p{L}_][\\p{L}\\p{N}_·-]*|#text|@[\\p{L}_][\\p{L}\\p{N}_·-]*)$"
    }
  },
  "properties": {
    "modulTyp": {
      "const": "format"
    },
    "moduleVersion": {
      "description": "Fassung des Moduls, ganzzahlig ab 1.",
      "type": "integer",
      "minimum": 1
    },
    "format": {
      "description": "Kennung des Kanals. Ab Werk belegte Kennungen sind nicht überschreibbar (prüft nur der Kern).",
      "type": "string",
      "pattern": "\\S"
    },
    "richtung": {
      "description": "`import` (Vorgabe, auch bei null) oder `export`.",
      "enum": [
        "import",
        "export",
        null
      ]
    },
    "sektor": {
      "description": "Bereich, in den der Kanal liest oder aus dem er schreibt; muss dem Kern bekannt sein.",
      "type": "string",
      "pattern": "\\S"
    },
    "label": {
      "description": "Beschriftung im Import-Dialog. Reiner Text: kein Tag, keine Zeichenreferenz, kein doppeltes Anführungszeichen.",
      "type": "string",
      "pattern": "\\S",
      "not": {
        "pattern": "<[A-Za-z/!?]|&(?:#|[A-Za-z][A-Za-z0-9]*;)|\""
      }
    },
    "sprache": {
      "description": "Sprache von `label` (BCP-47-Form, z. B. `de`, `en-GB`). Pflicht, weil jedes Format-Modul eine Beschriftung trägt.",
      "type": "string",
      "pattern": "^\\s*[a-z]{2,3}(-[A-Za-z0-9]{2,8})*\\s*$"
    },
    "akzeptiert": {
      "description": "Dateiauswahl-Filter; fehlt er, gilt `.json,application/json`.",
      "type": [
        "string",
        "null"
      ]
    },
    "leser": {
      "description": "Kennung einer eingebauten Lesart (`name@version`). Pflicht bei `richtung: import`; muss auflösen (prüft nur der Kern).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    },
    "schreiber": {
      "description": "Kennung eines eingebauten Schreibers (`name@version`); fehlt er, gilt `json@1`. Muss auflösen (prüft nur der Kern).",
      "type": [
        "string",
        "null"
      ],
      "pattern": "\\S"
    },
    "quelle": {
      "description": "Umschlag: der Pfad, unter dem die Werte in der Datei stehen.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/pfad"
        }
      ]
    },
    "quelleWurzelFallback": {
      "description": "Wird der Umschlag nicht gefunden, auf der Wurzel lesen.",
      "type": "boolean"
    },
    "rechtsraum": {
      "description": "Freiwillig: der Rechtsraum, an den der Kanal gebunden ist.",
      "type": [
        "string",
        "null"
      ]
    },
    "namensraum": {
      "description": "U2-ADR-465: Namensraum des Ziel-XML, als Standard-Namensraum an die Wurzel geschrieben. Nur für Ausgabe-Module mit dem Schreiber xml@1. Einen fremden Namensraum (alles außer urn:vivodepot: und https://vivodepot.de/) gibt der Kern nur einem Modul mit verifizierter Signatur frei (prüft nur der Kern).",
      "type": "string",
      "pattern": "^(?:urn:[A-Za-z0-9][A-Za-z0-9-]{0,31}:\\S+|https?://\\S+)$"
    },
    "wurzel": {
      "description": "U2-ADR-465: Name des Wurzelelements, unmittelbar statt als Pfad (ein XML-Name darf Punkte tragen, ein Pfad nicht). Nur an einem Ausgabe-Modul mit xml@1, und nicht zusammen mit `quelle`.",
      "type": "string",
      "pattern": "^[\\p{L}_][\\p{L}\\p{N}._·-]*$"
    },
    "hinweis": {
      "description": "U2-ADR-465: ein Hinweis des Moduls, den der Kern als XML-Kommentar vor die Wurzel schreibt (etwa „nicht einreichbar ohne Anhang“). Nur an einem Ausgabe-Modul mit xml@1; kein „--“, nicht auf „-“ endend.",
      "type": "string",
      "minLength": 1,
      "maxLength": 300,
      "pattern": "^(?!.*--)[^\\u0000-\\u001f<>]*[^\\u0000-\\u001f<>-]$"
    },
    "erkennen": {
      "description": "UND-verknüpfte Vergleiche, an denen der Kanal seine Datei erkennt. Fehlt die Liste, wird der Kanal von Hand gewählt.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pfad"
        ],
        "properties": {
          "pfad": {
            "$ref": "#/$defs/pfad"
          },
          "gleich": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "vorhanden": {
            "type": "boolean"
          },
          "istObjekt": {
            "type": "boolean"
          }
        },
        "anyOf": [
          {
            "required": [
              "gleich"
            ],
            "properties": {
              "gleich": true
            }
          },
          {
            "required": [
              "vorhanden"
            ],
            "properties": {
              "vorhanden": {
                "const": true
              }
            }
          },
          {
            "required": [
              "istObjekt"
            ],
            "properties": {
              "istObjekt": {
                "const": true
              }
            }
          }
        ]
      }
    },
    "zuordnung": {
      "description": "Depot-Feld ↔ Pfad in der Datei. Ein Modul erfindet kein Feld: `feld` muss im Bereich `sektor` (bzw. `bereich`) existieren (prüft nur der Kern). U2-ADR-465: `bereich` liest ein Feld aus einem anderen Bereich, `fest` schreibt einen festen Wert statt eines Felds; beides trägt nur in der Ausgabe (der Kern verwirft es beim Einlesen einzeln). Die Folge der Einträge ist die Elementfolge. `werte` bildet den Rohwert auf einen Zielwert ab, `teil` nimmt einen Teil eines Datums; beides nur in der Ausgabe.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ziel"
        ],
        "properties": {
          "feld": {
            "type": "string",
            "pattern": "\\S"
          },
          "ziel": {
            "$ref": "#/$defs/pfad"
          },
          "alsListe": {
            "type": "boolean"
          },
          "bereich": {
            "type": "string",
            "pattern": "\\S"
          },
          "fest": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "werte": {
            "description": "U2-ADR-465: Rohwert des Felds → Zielwert (etwa ein Code der Codeliste des Ziels). Ein Rohwert ohne Eintrag ergibt keinen Wert und wird gemeldet.",
            "type": "object",
            "minProperties": 1,
            "maxProperties": 1000,
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "teil": {
            "description": "U2-ADR-465: ein Teil eines Datums (aus der Kern-Liste FORMAT_TEILE).",
            "enum": [
              "jahr",
              "monat",
              "tag"
            ]
          }
        },
        "anyOf": [
          {
            "required": [
              "feld"
            ],
            "properties": {
              "feld": {
                "type": "string"
              }
            }
          },
          {
            "required": [
              "fest"
            ],
            "properties": {
              "fest": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "boolean"
                  }
                ]
              }
            }
          }
        ],
        "dependentSchemas": {
          "fest": {
            "properties": {
              "feld": false,
              "bereich": false,
              "alsListe": false,
              "werte": false,
              "teil": false
            }
          },
          "werte": {
            "properties": {
              "teil": false
            }
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "feld"
        ],
        "properties": {
          "feld": {
            "type": "string"
          }
        }
      }
    },
    "appVersion": {
      "description": "Vom Einlass gesetzt.",
      "type": "string"
    },
    "ungeprueft": {
      "description": "Vom Einlass gesetzt.",
      "type": "boolean"
    },
    "eingelassenAm": {
      "description": "Vom Einlass gesetzt.",
      "type": "string"
    }
  },
  "allOf": [
    {
      "description": "Ein Eingabekanal (auch ohne `richtung`) braucht einen Leser.",
      "if": {
        "required": [
          "richtung"
        ],
        "properties": {
          "richtung": {
            "const": "export"
          }
        }
      },
      "else": {
        "required": [
          "leser"
        ],
        "properties": {
          "leser": {
            "type": "string"
          }
        }
      }
    },
    {
      "description": "Ein XML-Ausgabekanal braucht eine Wurzel — in `quelle` als Pfad oder in `wurzel` als Name (U2-ADR-465), nicht beides — und jede Pfadstufe muss ein XML-Name sein.",
      "if": {
        "required": [
          "richtung",
          "schreiber"
        ],
        "properties": {
          "richtung": {
            "const": "export"
          },
          "schreiber": {
            "type": "string",
            "pattern": "^\\s*xml@1\\s*$"
          }
        }
      },
      "then": {
        "oneOf": [
          {
            "required": [
              "quelle"
            ],
            "properties": {
              "quelle": {
                "$ref": "#/$defs/xmlPfad"
              }
            },
            "not": {
              "required": [
                "wurzel"
              ],
              "properties": {
                "wurzel": {
                  "type": "string"
                }
              }
            }
          },
          {
            "required": [
              "wurzel"
            ],
            "properties": {
              "wurzel": {
                "type": "string"
              },
              "quelle": {
                "type": "null"
              }
            }
          }
        ],
        "properties": {
          "zuordnung": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "ziel": {
                  "$ref": "#/$defs/xmlPfad"
                }
              }
            }
          }
        }
      }
    },
    {
      "description": "U2-ADR-465: ein Namensraum nur an einem XML-Ausgabekanal.",
      "if": {
        "required": [
          "namensraum"
        ],
        "properties": {
          "namensraum": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "richtung",
          "schreiber"
        ],
        "properties": {
          "richtung": {
            "const": "export"
          },
          "schreiber": {
            "type": "string",
            "pattern": "^\\s*xml@1\\s*$"
          }
        }
      }
    },
    {
      "description": "U2-ADR-465: `wurzel` nur an einem XML-Ausgabekanal.",
      "if": {
        "required": [
          "wurzel"
        ],
        "properties": {
          "wurzel": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "richtung",
          "schreiber"
        ],
        "properties": {
          "richtung": {
            "const": "export"
          },
          "schreiber": {
            "type": "string",
            "pattern": "^\\s*xml@1\\s*$"
          }
        }
      }
    },
    {
      "description": "U2-ADR-465: `hinweis` nur an einem XML-Ausgabekanal.",
      "if": {
        "required": [
          "hinweis"
        ],
        "properties": {
          "hinweis": {
            "type": "string"
          }
        }
      },
      "then": {
        "required": [
          "richtung",
          "schreiber"
        ],
        "properties": {
          "richtung": {
            "const": "export"
          },
          "schreiber": {
            "type": "string",
            "pattern": "^\\s*xml@1\\s*$"
          }
        }
      }
    }
  ]
}
