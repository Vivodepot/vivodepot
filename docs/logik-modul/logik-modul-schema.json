    "block": {
      "description": "Ein Block. `typ` aus der geschlossenen Liste der Block-Handler des Kerns. Weitere Schlüssel (texte, feldId, frage, luecke …) prüft der Kern beim Einlass nicht; das Schema lässt sie offen.",
      "type": "object",
      "required": [
        "typ"
      ],
      "properties": {
        "typ": {
          "enum": [
            "mehrfachauswahl",
            "auswahl",
            "auswahlFest",
            "auswahlPaar",
            "auswahlPaarGruppe",
            "immer",
            "freitext",
            "freitextSatz",
            "refMehrfach",
            "refMehrfachVoll",
            "rollePerson",
            "crossRef",
            "frageAntwortOderLuecke",
            "instrumentPersonVerweis"
          ]
        },
        "bedingung": {
          "description": "Freiwillig; `null` heißt: keine Bedingung.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bedingung0"
            }
          ]
        },
        "format": {
          "description": "Freiwillig; `null` heißt: keine Formatierung. Weitere Schlüssel (praefix, sektor, feld, unterfeld) offen.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "typ"
              ],
              "properties": {
                "typ": {
                  "enum": [
                    "liste",
                    "codeListeLabel"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "abschnitt": {
      "description": "Ein Abschnitt: entweder eine Eingangsformel (dann liest der Kern die Blöcke nicht) oder eine Liste von Blöcken.",
      "anyOf": [
        {
          "type": "object",
          "required": [
            "eingangsformel"
          ],
          "properties": {
            "eingangsformel": {
              "not": {
                "enum": [
                  false,
                  0,
                  "",
                  null
                ]
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bloecke"
          ],
          "properties": {
            "bloecke": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/block"
              }
            }
          }
        }
      ]
    },
    "datenEintrag": {
      "description": "Ein Datenlese-Eintrag. `typ` aus einer geschlossenen Liste. Ob Bereich und Feld existieren und ob ein Feld sensibel ist, prüft nur der Kern; ein sensibles Feld verlangt `sensibelErlaubt: true` an genau diesem Eintrag.",
      "type": "object",
      "required": [
        "typ"
      ],
      "properties": {
        "typ": {
          "enum": [
            "feld",
            "verbinden",
            "listenfeld",
            "personenNamen",
            "listenfeldPersonenNamen",
            "listenfeldAlle"
          ]
        },
        "sektor": {
          "description": "Kennung eines Bereichs. Ob es ihn gibt, prüft nur der Kern.",
          "type": "string",
          "minLength": 1
        },
        "feld": {
          "type": "string"
        },
        "unterfeld": {
          "type": "string"
        },
        "trenner": {
          "type": "string"
        },
        "sensibelErlaubt": {
          "description": "Ausdrückliches Recht, ein sensibles Feld zu lesen. Nur `true` wirkt.",
          "type": "boolean"
        },
        "teile": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "sektor",
              "feld"
            ],
            "properties": {
              "sektor": {
                "description": "Kennung eines Bereichs. Ob es ihn gibt, prüft nur der Kern.",
                "type": "string",
                "minLength": 1
              },
              "feld": {
                "type": "string"
              }
            }
          }
        },
        "diskriminante": {
          "type": "object",
          "required": [
            "feld",
            "wert"
          ],
          "properties": {
            "feld": {
              "type": "string"
            },
            "wert": {
              "type": "string"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "typ"
            ],
            "properties": {
              "typ": {
                "const": "verbinden"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "teile"
            ],
            "properties": {
              "teile": true
            }
          },
          "else": {
            "type": "object",
            "required": [
              "sektor",
              "feld"
            ],
            "properties": {
              "sektor": true,
              "feld": true
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "typ"
            ],
            "properties": {
              "typ": {
                "enum": [
                  "listenfeld",
                  "listenfeldPersonenNamen"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "diskriminante"
            ],
            "properties": {
              "diskriminante": true
            }
          }
        }
      ]
