{
  "name": "vivodepot-tests",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Stehende Testsuite (U2-ADR-004) für vivodepot.html. Die HTML wird nur gelesen; die <script>-Blöcke werden zur Laufzeit geladen. Schicht 1 (node --test) läuft offline; Schicht 2 (Playwright/axe, test:e2e) braucht Browser-Binaries und läuft am Mac/CI.",
  "scripts": {
    "test": "node tools/geteilte-git-config-wache.js -- node --test --test-timeout=300000 --require ./tools/lib/test-zeitgrenze-preload.js --require ./tests/hook-sperre-testumgebung.js 'tests/**/*.test.js' 'tools/**/*.test.js'",
    "test:datei": "node --test --require ./tools/lib/test-zeitgrenze-preload.js --require ./tests/hook-sperre-testumgebung.js",
    "zeremonie": "node tools/basistemplate-zeremonie-automat.js",
    "test:e2e": "playwright test",
    "test:e2e:cross": "playwright test --config=playwright.config.cross.js",
    "test:e2e:firefox": "playwright test --config=playwright.config.firefox.js",
    "test:cross:gates": "node --test tests/e2e-cross/*.test.js",
    "test:konformitaet": "node --test tests/konformitaet/krypto-vektoren.mjs tests/konformitaet/ed25519-wycheproof.mjs tests/konformitaet/offline-garantie.mjs tests/konformitaet/kein-master-key.mjs tests/konformitaet/extractable-inventur.js tests/konformitaet/wcag-axe.mjs tests/konformitaet/wcag-axe-lesen.mjs",
    "test:konformitaet:extern": "node --test tests/konformitaet/externe-validatoren.mjs",
    "krypto:harness": "node tools/independent-krypto-harness.js",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:report": "playwright show-report",
    "codelisten:build": "node tools/build-code-listen.js",
    "codelisten:check": "node tools/build-code-listen.js --check",
    "bereiche:build": "node tools/build-bereiche.js",
    "bereiche:check": "node tools/build-bereiche.js --check",
    "logiktypen:build": "node tools/build-logik-typen.js",
    "logiktypen:check": "node tools/build-logik-typen.js --check",
    "zusicherungen:build": "node tools/zusicherungs-schluessel-erheben.js --schreiben && node tools/zusicherungs-schluessel-erheben.js --datei vivodepot.html --schreiben",
    "zusicherungen:check": "node tools/zusicherungs-schluessel-erheben.js --check && node tools/zusicherungs-schluessel-erheben.js --datei vivodepot.html --check",
    "feldkatalog:build": "node tools/build-feldkatalog.js",
    "feldkatalog:check": "node tools/build-feldkatalog.js --check",
    "torwaechter:build": "node tools/build-torwaechter.js",
    "torwaechter:check": "node tools/build-torwaechter.js --check",
    "antwort:reichweite": "node tools/lese-antwort-reichweite-pruefen.js",
    "aussagen:abgleich": "node tools/aussagen-abgleich-pruefen.js --gate",
    "aussagen:grundlinie": "node tools/aussagen-abgleich-pruefen.js --grundlinie-schreiben",
    "webseite:stand": "node tools/webseite-stand-pruefen.js",
    "webseite:selbstprobe": "node tools/webseite-stand-pruefen.js --selbstprobe",
    "feldtyp:spiegel": "node tools/feldtyp-spiegel-pruefen.js --gate",
    "standzahlen:build": "node tools/build-standzahlen.js",
    "standzahlen:check": "node tools/build-standzahlen.js --check",
    "reisen": "node tools/reisen-lauf.js --alle",
    "reisen:eine": "node tools/reisen-lauf.js --reise",
    "personas": "node --test tests/persona-p6-durchlauf.test.js tests/personas-durchlauf.test.js tests/lebenslagen-katalog.test.js",
    "bereiche:waechter": "node tools/bereichslisten-pruefen.js",
    "bereiche:zahl": "node tools/bereichszahl-pruefen.js",
    "styleguide:komponenten": "node tools/styleguide-komponenten-abgleich.js --check",
    "sbom:build": "node tools/sbom-pflegen.js",
    "sbom:check": "node tools/sbom-pflegen.js --check",
    "ableitungen:build": "node tools/ableitungen-build.js",
    "dateipruefsumme:build": "node tools/build-dateipruefsumme.js",
    "dateipruefsumme:check": "node tools/build-dateipruefsumme.js --check",
    "fassungen:build": "node tools/fassungen-register.js --build",
    "fassungen:check": "node tools/fassungen-register.js --check",
    "worktree:check": "node tools/worktree-guard.js",
    "zusicherungen:pruefen": "node tools/zusicherungen-pruefen.js",
    "zusicherungen:negativproben": "node tools/zusicherungen-negativproben.js",
    "waechter:selbsttest": "node tools/waechter-selbsttest.js",
    "waechter:inventur": "node tools/waechter-inventur.js",
    "pruefen": "node tools/pruefen.js",
    "stand": "node tools/stand-zeile.js",
    "schema:wirkung": "node tools/schema-wirkung-pruefen.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.1",
    "@playwright/test": "^1.45.0",
    "fast-check": "^4.9.0",
    "ical.js": "^2.2.1",
    "playwright": "^1.45.0",
    "vcard-parser": "^1.0.0"
  },
  "license": "EUPL-1.2"
}
