    "todesfall-uebernahme": {
      "icon": "fileText",
      "modus": "eigen",
      "titel": "Nach einem Todesfall",
      "einfuehrung": "Nach einem Todesfall müssen Sie oft ein Depot übernehmen, das eine andere Person angelegt hat. Hier finden Sie die nötigen Schritte geordnet — was zu besorgen ist, wie Sie an die Daten kommen und was rechtlich zu beachten ist.",
      "anlass": {
        "klasse": 3,
        "icon": "fileText",
        "ziel": {
          "sbl": "todesfall-uebernahme"
        },
        "versteckt": true,
        "position": 14
      },
      "bloecke": [
        {
          "id": "die-ersten-unterlagen",
          "hint": "Besorgen Sie die Sterbeurkunde — sie wird für nahezu jeden weiteren Schritt gebraucht. Prüfen Sie außerdem, ob eine Vollmacht über den Tod hinaus vorliegt: Sie kann den Zugang zu Konten und Verträgen erheblich vereinfachen.",
          "titel": "Die ersten Unterlagen"
        },
        {
          "id": "ueberblick-verschaffen",
          "hint": "Verschaffen Sie sich einen Überblick, welche Sub-Depots die verstorbene Person verwaltet hat — etwa für Kinder oder andere ihr anvertraute Personen. Falls die verstorbene Person selbst Empfehlungen für die Nachfolge hinterlegt hat, stehen sie in ihren eigenen Unterlagen.",
          "titel": "Überblick verschaffen"
        },
        {
          "id": "ein-sub-depot-uebernehmen",
          "hint": "Ein Sub-Depot wird als verschlüsselte Datei übergeben und lässt sich in Ihre eigene Verwaltung aufnehmen, ohne dass die Datei neu verschlüsselt werden muss. Öffnen Sie dazu in Ihrem Depot die Übersicht „Verwaltete Depots“ (in der Seitenleiste) und wählen Sie dort „Depot einhängen“.",
          "titel": "Ein Sub-Depot übernehmen"
        },
        {
          "id": "ein-sub-depot-weitergeben",
          "hint": "Führen Sie selbst ein Sub-Depot, das jetzt an eine bevollmächtigte Person gehen soll, stehen in „Verwaltete Depots“ zwei Wege mit unterschiedlicher Folge. „Verschlüsselte Datei exportieren“ gibt eine Kopie heraus — Ihre eigene Verwaltung bleibt bestehen, ein erneuter Export ist jederzeit möglich. „Übergabe abgeschlossen — aus meiner Verwaltung entfernen“ mit der Wahl „Ich gebe es ab.“ löscht den Umschlag bei Ihnen — unumkehrbar, eine spätere Wiederaufnahme ist danach gesperrt.",
          "titel": "Ein Sub-Depot weitergeben"
        },
        {
          "id": "zugang-zu-den-daten",
          "hint": "Ein übergebenes Sub-Depot hängen Sie wie in Schritt 3 beschrieben in „Verwaltete Depots“ ein — die Datei bleibt dabei mit ihrem eigenen Passwort versiegelt, das Ihnen separat mitgeteilt werden muss. Das ist bei einem übergebenen Sub-Depot der einzige Weg. Nur wenn Sie stattdessen die vollständige Depot-Datei der verstorbenen Person selbst vorliegen haben und diese zu Lebzeiten ein Fach für Sie eingerichtet hatte, öffnen Sie sie über die Willkommensseite mit „Datei öffnen“ und dem Passwort, das sie Ihnen dafür gegeben oder hinterlegt hat — erreichbar nur außerhalb einer bereits offenen Sitzung, also über die Startseite.",
          "titel": "Zugang zu den Daten"
        },
        {
          "id": "digitale-nachbildung-ki-verfuegung",
          "eintraege": [
            {
              "quelle": "advanceCare",
              "feld": "liste:provisionInstruments:ki-verfuegung:basicDecision"
            }
          ],
          "hint": "Die verstorbene Person hat Angaben zu einer digitalen Nachbildung hinterlegt. Das vollständige Dokument finden Sie im Bereich „Vorsorge & Recht“.",
          "titel": "Digitale Nachbildung (KI-Verfügung)",
          "bedingung": "ki-hat-daten"
        },
        {
          "id": "rechtliche-einordnung",
          "hint": "Eine Vollmacht kann auch über den Tod hinaus gelten. Ob das bei Ihrer Vollmacht so ist, ergibt sich zunächst aus ihrem Wortlaut; steht dort nichts dazu, lassen Sie es anwaltlich klären. Bevollmächtigte und Erben sind zwei verschiedene Rollen. Dieser Text ersetzt keine Rechtsberatung.",
          "titel": "Rechtliche Einordnung"
        }
      ]
    }
