                    "wert": "ja"
                  }
                ]
              }
            },
            {
              "typ": "crossRef",
              "text": "Ich habe eine Betreuungsverfügung errichtet.",
              "bedingung": {
                "typ": "oder",
                "bedingungen": [
                  {
                    "typ": "listeEnthaeltTyp",
                    "feld": "provisionInstruments",
                    "wertFeld": "instrument",
                    "wert": "custodianship-declaration"
                  },
                  {
                    "typ": "feldGleich",
                    "feld": "betreuungsverfuegung",
                    "wert": "ja"
                  }
                ]
              }
            }
          ]
        },
        {
