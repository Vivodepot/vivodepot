          "color": "var(--ink)"
        }
      },
      {
        "art": "ueberschrift-3",
        "selektor": ".vd-h3",
        "regeln": {
          "font-size": "var(--fs-role-gruppe)",
          "font-weight": "var(--fw-semibold)",
          "color": "var(--ink)"
        }
      },
      {
        "art": "seitenleiste-gruppe",
