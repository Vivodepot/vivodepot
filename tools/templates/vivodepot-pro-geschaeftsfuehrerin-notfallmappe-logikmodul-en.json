  "abschnitte": [
    {
      "titel": "Part A — Representation",
      "bloecke": [
        { "typ": "immer", "texte": ["Who acts for the company if the managing director is suddenly unavailable? This extract collects what the Pro depot already holds on that question. It replaces neither a commercial power of attorney (Handlungsvollmacht) itself nor information from the commercial register court (Registergericht)."] },
        { "typ": "frageAntwortOderLuecke", "feldId": "vertretungsregelung",
          "frage": "Company's representation arrangement?", "luecke": "— not recorded —" },
        { "typ": "frageAntwortOderLuecke", "feldId": "prokura_inhaber",
          "frage": "Statutory power of representation (Prokura) granted to?", "format": { "typ": "liste" }, "luecke": "— not recorded —" }
      ]
    },
    {
      "titel": "Part B — Succession",
      "bloecke": [
        { "typ": "immer", "texte": ["The following details come from the Pro module \"Company and succession arrangements\" — the same underlying data that also supports a handover or an emergency, read here for managing-director succession."] },
        { "typ": "frageAntwortOderLuecke", "feldId": "nachfolgeklausel",
          "frage": "Succession clause (Nachfolgeklausel) in the articles of association (Gesellschaftsvertrag) present?", "luecke": "— not recorded —" },
        { "typ": "frageAntwortOderLuecke", "feldId": "gesellschafterliste_stand",
          "frage": "List of shareholders (Gesellschafterliste) — version(s) dated?", "format": { "typ": "liste" }, "luecke": "— not recorded —" },
        { "typ": "frageAntwortOderLuecke", "feldId": "testament_erbvertrag_ablageort",
          "frage": "Will (Testament) or inheritance contract (Erbvertrag) — where filed?", "luecke": "— not recorded —" }
      ]
    },
    {
      "titel": "Part C — Emergency",
      "bloecke": [
        { "typ": "immer", "texte": ["Note: \"Task\" and \"Person\" are read as two separate lists (same line order, no automatic pairing) — the extract itself can be extended to cross-reference line by line, if needed."] },
        { "typ": "frageAntwortOderLuecke", "feldId": "vertretungsplan_aufgabe",
          "frage": "Cover plan — which tasks are assigned?", "format": { "typ": "liste" }, "luecke": "— not recorded —" },
        { "typ": "frageAntwortOderLuecke", "feldId": "vertretungsplan_person",
          "frage": "Cover plan — who takes each one on?", "format": { "typ": "liste" }, "luecke": "— not recorded —" },
        { "typ": "frageAntwortOderLuecke", "feldId": "wer_weiss_vom_depot",
          "frage": "Who knows that this depot exists?", "format": { "typ": "liste" }, "luecke": "— not recorded —" },
        { "typ": "frageAntwortOderLuecke", "feldId": "patientenverfuegung_ablageort",
          "frage": "Advance healthcare directive (Patientenverfügung) — where filed?", "luecke": "— not recorded —" },
        { "typ": "frageAntwortOderLuecke", "feldId": "kontakt_telefon",
          "frage": "Phone?", "luecke": "— not recorded —" },
        { "typ": "frageAntwortOderLuecke", "feldId": "kontakt_email",
          "frage": "Email?", "luecke": "— not recorded —" }
      ]
    }
  ],
  "dokAusgabe": {
